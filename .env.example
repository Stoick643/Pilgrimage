# LLM API keys — at least one is required (first available is used)
# Priority: DeepSeek > Moonshot > OpenAI
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Unsplash API key (optional) — for city photos. Falls back to placeholder if missing.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Google Maps API key (optional) — for geocoding cities and displaying route map
GOOGLE_DIRECTIONS_API_KEY=your_google_api_key_here

# OpenWeatherMap API key (optional) — for 5-day weather forecasts
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
